# Ignore data directories contents
data/raw/*
data/processed/*
data/interim/*

# Don't ignore empty data directories
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/interim/.gitkeep

# Ignore Python cache directories
__pycache__/
*.py[cod]

# Ignore Python packaging
*.egg-info/

# Ignore virtual environment
.venv/
venv/

# Ignore playground directory contents
src/playground/*

# Ignore reports directory contents except for gitkeep file
src/reports/*
!src/reports/.gitkeep

# Ignore logs directory contents except for gitkeep file
logs/*
!logs/.gitkeep